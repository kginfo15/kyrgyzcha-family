# ===== DeafBridge KG サーバー環境変数 =====
# ローカル: このファイルを .env.local にコピーして値を入れる
# Vercel:   Project Settings → Environment Variables に登録する
# ※ どの値もブラウザには送られません（NEXT_PUBLIC_ を付けないこと）

# --- 音声認識（どちらか一方）。両方未設定ならデモモードで動きます ---
# 1) API キー（簡単）。Cloud Console で「Speech-to-Text API」「Cloud Translation API」だけに制限すること
GOOGLE_API_KEY=
# 2) サービスアカウント JSON（JSON 文字列そのまま、または base64）
GOOGLE_SERVICE_ACCOUNT_JSON=

# 認識モデル（任意）。例: latest_short（短い発話向け）, default
# GOOGLE_STT_MODEL=latest_short

# 翻訳表示を使わない場合は false（費用削減）
# TRANSLATION_ENABLED=true

# 強制的にデモモードにする場合
# STT_PROVIDER=mock

# --- 不正利用対策 ---
# 設定すると、アプリの設定画面でこのコードを入力した端末だけが文字化を使える
APP_ACCESS_CODE=
# 1 IP あたり 1 分間の文字化リクエスト上限（既定 30）
# RATE_LIMIT_PER_MINUTE=30
